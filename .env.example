ZERO_COST_MODE=true
# private (default, §14) or public. Exactly one. Public is NOT internet-ready yet (IDEA-019).
COMPOSE_PROFILES=private

POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowdesk
POSTGRES_PORT=5432
API_PORT=8000
LOG_LEVEL=INFO

# How often Beat runs the worker canary, in seconds. /health/ready calls the worker stale after three
# missed runs. Leave it at 60 unless you are testing the stale state (infra/smoke-m2-slice1.sh does).
# CANARY_INTERVAL_SECONDS=60

# Scheduled encrypted backups with an off-box copy (docs/BACKUP.md, "Scheduled backups"). Everything here is
# optional until you set the destination; with BACKUP_SSH_HOST blank the backups stay local and /health/data
# says the copy is not_configured. The key files are paths on THIS machine, outside the repo.
# BACKUP_AT=03:00
# BACKUP_TZ=America/New_York
# BACKUP_SSH_HOST=
# BACKUP_SSH_USER=
# BACKUP_SSH_PORT=22
# The folder on the destination, which the permissions were set on. For Windows OpenSSH it looks like /C:/FlowdeskBackups.
# BACKUP_SSH_PATH=
# BACKUP_SSH_KEY_FILE=C:/Users/you/.ssh/flowdesk_backup
# BACKUP_SSH_KNOWN_HOSTS_FILE=C:/Users/you/.ssh/flowdesk_backup_known_hosts
# Pinged after each successful off-box copy. If the pings stop, the monitor alerts. It is a credential.
# BACKUP_PING_URL=
# Failed attempts retry after 15 minutes, doubling up to a cap that depends on whether a retry can help:
#   RETRY_CAP (30): the destination cannot be reached. The laptop coming home changes the outcome.
#   RETRY_LONG_CAP (360): anything else that may clear on its own (a failing dump, a refused key).
# A configuration problem (no recipient key, a bad setting) is not retried before the next slot; after fixing it,
# `docker compose restart backup` retries at once.
# BACKUP_RETRY_MINUTES=15
# BACKUP_RETRY_CAP_MINUTES=30
# BACKUP_RETRY_LONG_CAP_MINUTES=360

# External dead-man monitor's ping URL (ADR-0008). It is a credential. Leave blank on development
# machines; set it only on a deployed instance. docs/HEARTBEAT.md explains why.
HEARTBEAT_URL=
