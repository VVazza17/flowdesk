ZERO_COST_MODE=true
# private (default, §14) or public. Exactly one. Public is NOT internet-ready yet (IDEA-019).
COMPOSE_PROFILES=private

POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowdesk
POSTGRES_PORT=5432
API_PORT=8000
LOG_LEVEL=INFO

# How often Beat runs the worker canary, in seconds. /health/ready calls the worker stale after three
# missed runs. Leave it at 60 unless you are testing the stale state (infra/smoke-m2-slice1.sh does).
# CANARY_INTERVAL_SECONDS=60

# External dead-man monitor's ping URL (ADR-0008). It is a credential. Leave blank on development
# machines; set it only on a deployed instance. docs/HEARTBEAT.md explains why.
HEARTBEAT_URL=
