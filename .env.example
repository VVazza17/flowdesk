ZERO_COST_MODE=true
# private (default, §14) or public. Exactly one. Public is NOT internet-ready yet (IDEA-019).
COMPOSE_PROFILES=private

POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowdesk
POSTGRES_PORT=5432
API_PORT=8000
LOG_LEVEL=INFO

# How often Beat runs the worker canary, in seconds. /health/ready calls the worker stale after three
# missed runs. Leave it at 60 unless you are testing the stale state (infra/smoke-m2-slice1.sh does).
# CANARY_INTERVAL_SECONDS=60

# The longest any task may run, in seconds; Celery kills it past this. /health/ready calls the ingest worker
# stale when its canary is older than this plus three canary intervals, so raising it makes a wedged ingest
# worker take longer to show. A guess until a real feed has been timed (app/settings.py). Leave it unless you
# are testing (infra/smoke-m2-slice5-step0.sh sets it to 20).
# INGEST_TASK_MAX_SECONDS=1800

# Scheduled encrypted backups with an off-box copy to Backblaze B2 (docs/BACKUP.md, "Scheduled backups"). Everything
# here is optional until the bucket exists; with B2_BUCKET blank the backups stay local and /health/data says the copy
# is not_configured. The key ID and key are SECRETS: here only, never in chat, logs or stored errors.
# BACKUP_AT=03:00
# BACKUP_TZ=America/New_York
# The bucket, and its S3 endpoint: https://s3.<region>.backblazeb2.com (the region is in the bucket's details).
# B2_BUCKET=
# B2_ENDPOINT=
# The WRITE key (stack machine): restricted to the bucket, capabilities listBuckets,listAllBucketNames,listFiles,
# writeFiles,readFileRetentions and nothing else. The copy refuses, and pages, if it holds any other.
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# The READ key, on the LAPTOP only, for the restore drill (infra/restore-backup.sh --from-b2). Never on the stack machine.
# B2_READ_KEY_ID=
# B2_READ_APPLICATION_KEY=
# Pinged after each verified off-box copy. If the pings stop, the monitor alerts. A refused key, a key holding a
# capability it must not, an upload not locked, a delete marker nobody made, or the bucket over 95% of the free 10 GB
# POSTs to this URL + /fail, so the monitor alerts at once. It is a credential.
# BACKUP_PING_URL=
# Failed attempts retry after 15 minutes, doubling up to a cap that depends on whether a retry can help:
#   RETRY_CAP (30): B2 or the network cannot be reached; their coming back changes the outcome.
#   RETRY_LONG_CAP (360): anything else that may clear on its own (a failing dump, an alert being fixed in B2).
# A configuration problem (no recipient key, a bad setting) is not retried before the next slot; after fixing it,
# `docker compose restart backup` retries at once.
# BACKUP_RETRY_MINUTES=15
# BACKUP_RETRY_CAP_MINUTES=30
# BACKUP_RETRY_LONG_CAP_MINUTES=360

# FRED (M2 slice 5). A free key from https://fredaccount.stlouisfed.org/apikeys: 32 lowercase letters
# and digits, and a credential (it rides in the request URL, so nothing may log that URL). Required for the
# backfill (`python -m app.backfill`) and the daily poll (`ingest.fred_poll`); blank, both fail loudly with `NotConfigured`
# and nothing else is affected. A malformed value is refused when the FRED task reads it, without
# being echoed.
# FRED_API_KEY=
# The User-Agent the FRED client sends. FRED documents no requirement, so blank means the default, which
# names the app and nobody else. Do not put a personal email here unless you mean to.
# FRED_USER_AGENT=
# Point the FRED client at a local stub instead of the real API (a smoke test only). Blank is the real API.
# FRED_BASE_URL=

# External dead-man monitor's ping URL (ADR-0008). It is a credential. Leave blank on development
# machines; set it only on a deployed instance. docs/HEARTBEAT.md explains why.
HEARTBEAT_URL=

# M2 slice 6 step 6: schedule the settled bars polls (10:05 ET Mon-Fri; 09:05 until 2026-11-20). Leave false until IDEA-029 closes
# (the desktop restore drill, docs/BACKUP.md).
BARS_POLL_ENABLED=false
